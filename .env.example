VITE_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=your_anon_key_here

# PayBolt — API token from dashboard (used as user_token in API calls)
VITE_PAYBOLT_USER_TOKEN=your_paybolt_user_token
# Dev: Vite proxy avoids CORS
VITE_PAYBOLT_PROXY=/api/paybolt
# VITE_PAYBOLT_API_BASE=https://www.paybolt.online/api

# PayBolt dashboard → Webhook URL (after deploying supabase/functions/paybolt-webhook):
# https://YOUR_PROJECT_REF.supabase.co/functions/v1/paybolt-webhook
